# =============================================================================
# Docker Build Ignore File
# =============================================================================
# Excludes files/directories from Docker build context to speed up builds

# Git
.git
.gitignore
.gitmodules

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.env
.env.*

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
*.sublime-*

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/

# Logs
*.log
*_pid.txt
logs/

# Documentation (not needed in container)
*.md
!README.md
docs/

# Paper-specific files (not needed in container)
paper.md
paper.pdf
ees_evaluation_*.md

# Large outputs (mounted as volumes instead)
outputs/
data/

# Large result files
*.json
!configs/*.json

# Temporary files
tmp/
temp/
*.tmp
core.*
tmp_bigfile
